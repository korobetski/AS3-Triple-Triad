# Local development environment for `compose.yaml`. Copy to `.env`, which is git-ignored.
#
#   cp .env.sample .env
#
# These values are development-only and are the defaults baked into `compose.yaml`, so an empty
# `.env` works. Override them when the defaults collide with something already running — most
# often POSTGRES_PORT, if a Postgres is already installed on the host.
#
# Nothing here is a secret and nothing here may be reused in a deployed environment.

POSTGRES_USER=tripletriad
POSTGRES_PASSWORD=tripletriad
POSTGRES_DB=tripletriad

# The host port. The container always listens on 5432 internally.
POSTGRES_PORT=5432
